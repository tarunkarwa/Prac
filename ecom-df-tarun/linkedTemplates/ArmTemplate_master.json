{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ecom-df-tarun"
		},
		"source_adls_raw_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'source_adls_raw'"
		},
		"target_parquet_file_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'target_parquet_file'"
		},
		"source_adls_raw_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://ecomadlstarun.dfs.core.windows.net/"
		},
		"target_parquet_file_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://ecomadlstarun.dfs.core.windows.net/"
		},
		"trigger_user_data_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/714548bf-acd2-47a0-b027-7f4f7c09e4ca/resourceGroups/ecom-project/providers/Microsoft.Storage/storageAccounts/ecomadlstarun"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ecom-df-tarun_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"source_adls_raw_accountKey": {
						"value": "[parameters('source_adls_raw_accountKey')]"
					},
					"target_parquet_file_accountKey": {
						"value": "[parameters('target_parquet_file_accountKey')]"
					},
					"source_adls_raw_properties_typeProperties_url": {
						"value": "[parameters('source_adls_raw_properties_typeProperties_url')]"
					},
					"target_parquet_file_properties_typeProperties_url": {
						"value": "[parameters('target_parquet_file_properties_typeProperties_url')]"
					},
					"trigger_user_data_properties_typeProperties_scope": {
						"value": "[parameters('trigger_user_data_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}